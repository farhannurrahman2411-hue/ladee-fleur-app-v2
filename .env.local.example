# Salin file ini jadi ".env.local" lalu isi dengan data dari project Supabase kamu
# (Supabase Dashboard > Project Settings > API)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key-jangan-disebar

# Bikin sendiri, string acak panjang untuk mengamankan sesi login
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang-dan-rahasia
