# ==============================================================================
# LADEE FLEUR APP - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi ".env.local" atau ".env" untuk konfigurasi lokal/production.

# ------------------------------------------------------------------------------
# 1. OPSI A: PRODUCTION (SUPABASE CLOUD)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. OPSI B: LOCAL DEVELOPMENT (SUPABASE CLI LOCAL / DOCKER)
# ------------------------------------------------------------------------------
# Jika menjalankan "npx supabase start":
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-service-role-key

# ------------------------------------------------------------------------------
# 3. KONEKSI POSTGRESQL NATIVE (LOCAL / SELF-HOSTED)
# ------------------------------------------------------------------------------
# Kredensial default PostgreSQL lokal: postgres:admin123
DATABASE_URL=postgresql://postgres:admin123@127.0.0.1:5432/ladee_fleur_db

# ------------------------------------------------------------------------------
# 4. KEAMANAN SESI LOGIN (JWT SESSION SECRET)
# ------------------------------------------------------------------------------
# String acak minimal 32 karakter untuk enkripsi token session cookie (HS256)
# Generate via terminal: openssl rand -base64 32
SESSION_SECRET=c8f9b2a7d4e6f1a3b5c7d9e0f2a4b6c8d0e1f3a5b7c9d1e3f5a7b9c1d3e5f7a9

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT & PORT (OPSIONAL)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
